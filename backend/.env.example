# ============================================================================
# CIMB Clicks Security Demo — environment template
# Copy to ".env" and fill in, OR export these as real environment variables.
# (See README for how to load them in PowerShell before `mvn spring-boot:run`.)
# ============================================================================

# --- Supabase (Project Settings > Database > Connection string > JDBC) ---
# Use the "Session pooler" or "Direct connection" JDBC URL. Example shape:
#   jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=jdbc:postgresql://<host>:5432/postgres
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<your-db-password>

# --- AES-256 key for encryption at rest (Module 4). 32 bytes, base64. ---
# Generate:  openssl rand -base64 32
APP_ENCRYPTION_KEY=<base64-32-bytes>

# --- HMAC secret for signing payment instructions (Module 2). Any long random string. ---
PAYMENT_SIGNING_KEY=change-me-to-a-long-random-secret

# --- Where the mock encrypted backup export is written (Module 4). ---
APP_BACKUP_DIR=./backups

# --- Optional: server port (default 8080) ---
PORT=8080
